{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Snipeshot",
  "version": "0.1.0",
  "identifier": "io.github.thomasdallinger.snipeshot",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "library",
        "title": "Snipeshot",
        "url": "index.html#/library",
        "width": 1100,
        "height": 720,
        "minWidth": 820,
        "minHeight": 520,
        "visible": false,
        "center": true
      },
      {
        "label": "settings",
        "title": "Snipeshot Settings",
        "url": "index.html#/settings",
        "width": 560,
        "height": 520,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["**"],
          "requireLiteralLeadingDot": false
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Capture, mark up and drag screenshots anywhere",
    "copyright": "Copyright (c) 2026 Thomas Dallinger",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
